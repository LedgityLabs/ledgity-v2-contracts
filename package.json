{
  "name": "ledgity-v2-contracts",
  "version": "1.0",
  "description": "Ledgity Yield | Smart-Contracts",
  "author": "blackwhale.eth",
  "license": "Apache-2.0",
  "main": "hardhat.config.ts",
  "scripts": {
    "compile": "hardhat compile && hardhat export --export-all data/deployments.json && ts-node scripts/extract-abis.mts && wagmi generate",
    "test": "forge test --use 0.8.18",
    "size": "hardhat size-contracts",
    "slither:report": "slither . --compile-force-framework hardhat --hardhat-artifacts-directory ./artifacts/ --checklist > report.md ",
    "deploy-reset:fork": "hardhat deploy --reset --network hardhat",
    "deploy-reset:fork-base": "cross-env HARDHAT_FORK_TARGET=base hardhat deploy --reset --network hardhat",
    "deploy-reset:base": "hardhat deploy --reset --network base",
    "deploy:fork": "hardhat deploy --network hardhat",
    "deploy:fork-base": "cross-env HARDHAT_FORK_TARGET=base hardhat deploy --network hardhat",
    "deploy:fork-sonic": "cross-env HARDHAT_FORK_TARGET=sonic hardhat deploy --network hardhat",
    "deploy:base": "hardhat deploy --network base",
    "deploy:sonic": "hardhat deploy --network sonic",
    "deploy:hedera": "hardhat deploy --network hedera",
    "verify:base": "hardhat verify-deploys --chain base --network base",
    "verify:sonic": "hardhat verify-deploys --chain sonic --network sonic",
    "prettier:check": "prettier --check --config ./.prettierrc.json --plugin=prettier-plugin-solidity .",
    "prettier:write": "prettier --write --config ./.prettierrc.json --plugin=prettier-plugin-solidity ."
  },
  "devDependencies": {
    "@chainlink/contracts": "^1.4.0",
    "@chainlink/contracts-ccip": "^1.6.0",
    "@nomicfoundation/hardhat-verify": "^2.0.14",
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@openzeppelin/contracts": "4.9.0",
    "@openzeppelin/contracts-upgradeable": "4.9.0",
    "@types/node": "^20.8.6",
    "@wagmi/cli": "^2.4.0",
    "colors": "^1.4.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "eslint": "^8.51.0",
    "hardhat": "^2.24.3",
    "hardhat-contract-sizer": "^2.10.0",
    "hardhat-deploy": "^1.0.3",
    "prettier": "^3.1.1",
    "prettier-plugin-solidity": "^1.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.2.2",
    "viem": "^2.33.2",
    "wagmi": "^2.16.1"
  }
}