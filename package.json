{
  "name": "ledgity-v2-contracts",
  "version": "1.0",
  "description": "Ledgity Finance | Smart-Contracts",
  "author": "blackwhale.eth",
  "license": "Apache-2.0",
  "main": "hardhat.config.ts",
  "scripts": {
    "compile": "hardhat compile",
    "test": "forge test --match-path \"tests/protocol-v2/*\" --no-match-contract Skip_ -vv",
    "test:log": "forge test --match-path \"tests/protocol-v2/*\" --no-match-contract Skip_ -vvv",
    "test:debug": "forge test --rerun --match-path \"tests/protocol-v2/*\" --no-match-contract Skip_ -vvv",
    "test:all": "forge test --no-match-contract Skip_",
    "size": "hardhat size-contracts",
    "typings": "hardhat compile && hardhat export --export-all data/deployments.json && npx hardhat extract-abis && wagmi generate",
    "slither:report": "slither . --compile-force-framework hardhat --hardhat-artifacts-directory ./artifacts/ --checklist > ./audit/slither-report.md",
    "deploy-reset:base": "hardhat deploy --reset --network base",
    "deploy-fork-reset:base": "cross-env HARDHAT_DEPLOY_FORK=base hardhat deploy --reset --network hardhat",
    "deploy-fork:mainnet": "cross-env HARDHAT_DEPLOY_FORK=mainnet hardhat deploy --network hardhat",
    "deploy-fork:sonic": "cross-env HARDHAT_DEPLOY_FORK=sonic hardhat deploy --network hardhat",
    "deploy-fork:arbitrum": "cross-env HARDHAT_DEPLOY_FORK=arbitrum hardhat deploy --network hardhat",
    "deploy-fork:linea": "cross-env HARDHAT_DEPLOY_FORK=linea hardhat deploy --network hardhat",
    "deploy-fork:base": "cross-env HARDHAT_DEPLOY_FORK=base hardhat deploy --network hardhat",
    "deploy-fork:hedera": ">>> Error: does not work because of flawed HTS simulation libs!!!",
    "deploy:mainnet": "hardhat deploy --network mainnet",
    "deploy:sonic": "hardhat deploy --network sonic",
    "deploy:arbitrum": "hardhat deploy --network arbitrum",
    "deploy:linea": "hardhat deploy --network linea",
    "deploy:base": "hardhat deploy --network base",
    "deploy:hedera": "hardhat deploy --network hedera",
    "upgrade-ltoken:base": "hardhat upgrade-ltoken-withdrawal-only --network base",
    "upgrade-ltoken:arbitrum": "hardhat upgrade-ltoken-withdrawal-only --network arbitrum",
    "upgrade-ltoken:linea": "hardhat upgrade-ltoken-withdrawal-only --network linea",
    "upgrade-ltoken:sonic": "hardhat upgrade-ltoken-withdrawal-only --network sonic",
    "upgrade-ltoken-fork:base": "cross-env HARDHAT_DEPLOY_FORK=base hardhat upgrade-ltoken-withdrawal-only --network hardhat",
    "upgrade-ltoken-fork:arbitrum": "cross-env HARDHAT_DEPLOY_FORK=arbitrum hardhat upgrade-ltoken-withdrawal-only --network hardhat",
    "upgrade-ltoken-fork:linea": "cross-env HARDHAT_DEPLOY_FORK=linea hardhat upgrade-ltoken-withdrawal-only --network hardhat",
    "upgrade-ltoken-fork:sonic": "cross-env HARDHAT_DEPLOY_FORK=sonic hardhat upgrade-ltoken-withdrawal-only --network hardhat",
    "test:upgrade-ltoken:base": "cross-env HARDHAT_DEPLOY_FORK=base forge test --match-path tests/protocol-v1/LTokenWithdrawalOnlyUpgrade.t.sol --threads 1 -vv",
    "test:upgrade-ltoken:arbitrum": "cross-env HARDHAT_DEPLOY_FORK=arbitrum forge test --match-path tests/protocol-v1/LTokenWithdrawalOnlyUpgrade.t.sol --threads 1 -vv",
    "test:upgrade-ltoken:linea": "cross-env HARDHAT_DEPLOY_FORK=linea forge test --match-path tests/protocol-v1/LTokenWithdrawalOnlyUpgrade.t.sol --threads 1 -vv",
    "test:upgrade-ltoken:sonic": "cross-env HARDHAT_DEPLOY_FORK=sonic forge test --match-path tests/protocol-v1/LTokenWithdrawalOnlyUpgrade.t.sol --threads 1 -vv",
    "verify:mainnet": "hardhat verify-deploys --chain mainnet --network mainnet",
    "verify:sonic": "hardhat verify-deploys --chain sonic --network sonic",
    "verify:arbitrum": "hardhat verify-deploys --chain arbitrum --network arbitrum",
    "verify:linea": "hardhat verify-deploys --chain linea --network linea",
    "verify:base": "hardhat verify-deploys --chain base --network base",
    "verify:hedera": "hardhat verify-deploys --chain hedera --network hedera",
    "prettier:check": "prettier --check --config ./.prettierrc.json --plugin=prettier-plugin-solidity .",
    "prettier:write": "prettier --write --config ./.prettierrc.json --plugin=prettier-plugin-solidity ."
  },
  "devDependencies": {
    "@chainlink/contracts": "^1.4.0",
    "@chainlink/contracts-ccip": "^1.6.0",
    "@nomicfoundation/hardhat-verify": "^2.0.14",
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@openzeppelin/contracts": "4.9.0",
    "@openzeppelin/contracts-upgradeable": "4.9.0",
    "@types/node": "^20.8.6",
    "@wagmi/cli": "^2.4.0",
    "colors": "^1.4.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "eslint": "^8.51.0",
    "hardhat": "^2.24.3",
    "hardhat-contract-sizer": "^2.10.0",
    "hardhat-deploy": "^1.0.3",
    "merkletreejs": "^0.6.0",
    "prettier": "^3.1.1",
    "prettier-plugin-solidity": "^1.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.2.2",
    "viem": "^2.33.2",
    "wagmi": "^2.16.1"
  }
}